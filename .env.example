# Copy to .env and fill in. Never commit .env.

GROQ_API_KEY=
# Large model does the matching and rewriting; small model parses the two documents.
GROQ_MODEL_LARGE=openai/gpt-oss-120b
GROQ_MODEL_SMALL=openai/gpt-oss-20b

# How many times the optimizer may be sent back when the fabrication guard finds problems.
MAX_REVISIONS=1
# Inputs longer than this are rejected rather than silently cut.
MAX_INPUT_CHARS=30000

# Optional: LangSmith tracing of every graph step
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=matchmycv
